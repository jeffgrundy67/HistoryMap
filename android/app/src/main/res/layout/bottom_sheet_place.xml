<?xml version="1.0" encoding="utf-8"?>
<!-- NestedScrollView plays nicely inside a BottomSheetDialog -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView android:id="@+id/txtAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="2dp" />
        <TextView android:id="@+id/txtCity" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="2dp" />
        <TextView android:id="@+id/txtCounty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="2dp" />
        <TextView android:id="@+id/txtType" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="2dp" />
        <TextView android:id="@+id/txtListed" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="2dp" />
        <TextView android:id="@+id/txtNhl" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp" />

        <!-- History section: summary when we have one, otherwise "No summary yet" -->
        <TextView
            android:id="@+id/txtHistoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_section_title"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/txtHistoryAttribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_attribution"
            android:textSize="11sp"
            android:textColor="#666666"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/txtHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:paddingBottom="12dp"
            android:maxHeight="220dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNomination"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/nomination_papers" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDirections"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/directions" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/close" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
